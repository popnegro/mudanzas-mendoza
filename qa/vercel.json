{
  "version": 2,
  "name": "mudanzas-mendoza",
  "installCommand": "npm install",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "dist/server.cjs"
    },
    {
      "handle": "filesystem"
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
