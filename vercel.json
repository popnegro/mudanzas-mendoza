{
  "version": 3,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    { "src": "api/**/*.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "/api/$1.ts" },
    { "src": "/sitemap.xml", "dest": "/api/sitemap.ts" },
    { "src": "/robots.txt", "dest": "/api/robots.ts" },
    { "src": "/manifest.json", "dest": "/api/manifest.ts" },
    { "src": "/rss.xml", "dest": "/api/rss.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
